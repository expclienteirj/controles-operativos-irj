{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "app/backend/**" }
    },
    {
      "src": "app/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/app/frontend/index.html" },
    {
      "src": "/sw.js",
      "dest": "/app/frontend/sw.js",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/(js|css)/(.*)",
      "dest": "/app/frontend/$1/$2",
      "headers": { "Cache-Control": "no-cache" }
    },
    { "src": "/(.*)", "dest": "/app/frontend/$1" }
  ]
}
