# Copiar a .env y completar con los valores reales. El .env no se versiona.
# En Vercel estos mismos valores van en Settings -> Environment Variables.

# --------------------------------------------------------------- base de datos
# Cadena de Postgres de Supabase. Vacía o ausente = SQLite local, que es como
# funciona la app hoy en la Mac.
#
# IMPORTANTE: usar el POOLER en modo transaction (puerto 6543), no la conexión
# directa (5432). Cada invocación de la función abre su propia conexión y contra
# el puerto directo se agota el límite de conexiones del proyecto.
# Supabase -> Project Settings -> Database -> Connection string -> Transaction pooler
IRJ_DB_URL=postgresql://postgres.<referencia>:<password>@<region>.pooler.supabase.com:6543/postgres

# --------------------------------------------------------- evidencia fotográfica
# Vacías = disco local (app/backend/data/uploads), el comportamiento histórico.
SUPABASE_URL=https://<referencia>.supabase.co

# Clave de SERVICIO (service_role), no la anónima. Da acceso total al proyecto
# saltándose las políticas de acceso: solo va en el servidor, nunca en el
# frontend ni en el repositorio.
SUPABASE_SERVICE_KEY=

# Bucket donde vive la evidencia. Crearlo PRIVADO en Supabase -> Storage.
SUPABASE_BUCKET=evidencia
